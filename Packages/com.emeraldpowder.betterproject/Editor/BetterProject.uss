/* Dark skin: rows and tiles hover in the Hierarchy's colour (the theme's row hover colour is barely apart from
   the panel backgrounds). Before the rules below so that "Highlight under mouse" off and selected rows still win. */
.bp-dark-hover .unity-collection-view__item:hover {
    background-color: #444444;
}

/* "Highlight under mouse" off: no hover colour on rows inside a panel with this class. Overriding the theme's
   --unity-colors-highlight-background-hover variable has no effect (the editor theme resolves it), so rows get an
   explicit transparent background instead. Selected rows keep their highlight: Favourites / Recents / content cells
   colour it inline (icon-view tiles carry the row class too), the folder tree's is kept by the rules below. */
.bp-no-hover .unity-collection-view__item:hover {
    background-color: rgba(0, 0, 0, 0);
}

/* A selected row looks the same under the mouse (any setting): Unity's theme draws it in the focused colours
   (blue, white text) on hover even when the list has no focus. Unfocused / focused list. */
.unity-collection-view .unity-collection-view__item--selected:hover {
    background-color: var(--unity-colors-highlight-background-inactive);
}

.unity-collection-view .unity-collection-view__item--selected:hover .unity-label {
    color: var(--unity-colors-default-text);
}

.unity-collection-view:focus .unity-collection-view__item--selected:hover {
    background-color: var(--unity-colors-highlight-background);
}

.unity-collection-view:focus .unity-collection-view__item--selected:hover .unity-label {
    color: #FFFFFF;
}
